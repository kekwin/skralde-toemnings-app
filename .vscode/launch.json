{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Waste collection dates",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/backend/server.ts",
      "runtimeArgs": ["--import", "tsx"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "skipFiles": [
        "<node_internals>/**"
      ],
      "serverReadyAction": {
        "pattern": "Skraldetømningsapp kører på\\s+http://localhost:([0-9]+)",
        "uriFormat": "http://localhost:%s",
        "action": "openExternally"
      }
    }
  ]
}
